{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwxa:research:personal-agent:session-task-link:0.11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_id",
    "session_ref",
    "task_ref",
    "linked_at",
    "link_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.11"
    },
    "link_id": {
      "type": "string",
      "pattern": "^STL-[A-Za-z0-9_-]+$"
    },
    "session_ref": {
      "$ref": "urn:iwxa:research:personal-agent:operation-ref:0.11"
    },
    "task_ref": {
      "$ref": "urn:iwxa:research:personal-agent:typed-ref:0.5"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    },
    "link_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
