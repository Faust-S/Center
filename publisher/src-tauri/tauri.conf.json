{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IWXA Publisher",
  "version": "0.4.0-dev.1",
  "identifier": "ru.iwxa.publisher",
  "build": {
    "beforeDevCommand": "npm run publisher:dev",
    "beforeBuildCommand": "npm run publisher:build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../../publisher-dist"
  },
  "app": {
    "windows": [{
      "title": "IWXA Publisher 0.4",
      "width": 1366,
      "height": 680,
      "minWidth": 700,
      "minHeight": 500,
      "dataDirectory": "webview"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
